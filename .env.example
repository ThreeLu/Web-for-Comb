# Comb-Search — AI summarization provider config.
# Copy to `.env` for local runs, or set these as GitHub repo Secrets/Variables.
#
# Only LLM_API_KEY is required. The rest default to DeepSeek.

# Required — your provider API key.
LLM_API_KEY=sk-...

# Optional — provider endpoint & model. Defaults shown (DeepSeek).
# For OpenAI:   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional — set to 0 if your provider lacks JSON response mode.
LLM_JSON_MODE=1

# Optional — parallel summarization workers.
LLM_MAX_WORKERS=4
